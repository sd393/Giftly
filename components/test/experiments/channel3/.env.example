# Sign up at https://trychannel3.com/sign-up — the key is shown immediately
# on https://trychannel3.com/dashboard/api.
CHANNEL3_API_KEY=

# Standard OpenAI key for the agent's tool-calling loop AND for the
# review-pipeline (verification, summarization, embeddings).
OPENAI_API_KEY=

# Optional override; defaults to gpt-4o-mini for cost.
OPENAI_MODEL=gpt-4o-mini

# Tavily — used by the review-pipeline scripts (reviews:seed, reviews:build)
# to search retailer/aggregator pages for product reviews. Free tier covers
# 1000 searches/month. https://tavily.com
TAVILY_API_KEY=
